<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/setup_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="@dimen/horizonal_padding"
        android:paddingTop="@dimen/portrait_padding"
        android:paddingBottom="@dimen/portrait_padding">

        <TextView
            android:id="@+id/select_app_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/main_select_app"
            android:textAppearance="@style/TextAppearance.SetupLogin.HeadlineSmall"
            android:textColor="@color/setup_on_surface_main" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="vertical">

            <TextView
                android:id="@+id/main_text_v"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textAppearance="@style/TextAppearance.SetupLogin.LabelMedium"
                android:textColor="@color/setup_on_surface_variant"
                android:paddingBottom="@dimen/item_border"
                tools:text="v1.0.0" />

            <ImageButton
                android:id="@+id/open_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_open_settings"
                android:src="@drawable/settings" />

        </LinearLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/main_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>